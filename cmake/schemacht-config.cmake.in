@PACKAGE_INIT@

# find_package(schemacht [version] [REQUIRED])
#
#   schemacht::schemacht   schemas, compile-time queries and the Postgres database pool

include(CMakeFindDependencyMacro)

find_dependency(Threads)
# Streaming results need libpq 17 (PQsetChunkedRowsMode, PQcancelCreate).
find_dependency(PostgreSQL 17)

include("${CMAKE_CURRENT_LIST_DIR}/schemacht-targets.cmake")

check_required_components(schemacht)
