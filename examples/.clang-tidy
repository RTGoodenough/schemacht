# The library's checks, minus those that fight example code: literal sample data, short natural names (`id`), an
# application's types defined in the one file, which a real program would declare in a header, and `argv[1]`, read as every
# program reads it.
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -misc-use-internal-linkage,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic

CheckOptions:
  - { key: misc-const-correctness.WarnPointersAsPointers, value: false }  # main's `char** argv`
