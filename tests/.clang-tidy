# The library's checks, minus those that fight test code: literal expected values, Catch2's macros, test-only globals, and
# casts out of an enum's range on purpose (Catch2's Flags are ORed together; a test formats a value no enumerator has).
InheritParentConfig: true
Checks: >
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -misc-use-anonymous-namespace,
  -concurrency-mt-unsafe,
  -cert-err58-cpp,
  -bugprone-chained-comparison,
  -bugprone-exception-escape,
  -google-build-using-namespace,
  -bugprone-throwing-static-initialization,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -readability-identifier-length,
  -readability-trailing-comma,
  -modernize-use-emplace,
  -clang-analyzer-optin.core.EnumCastOutOfRange
